{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateApplicationVersions",
      "Effect": "Allow",
      "Action": "elasticbeanstalk:CreateApplicationVersion",
      "Resource": [
        "arn:aws:elasticbeanstalk:ap-southeast-2:730279464171:application/library-booking-api",
        "arn:aws:elasticbeanstalk:ap-southeast-2:730279464171:application/library-booking-web",
        "arn:aws:elasticbeanstalk:ap-southeast-2:730279464171:applicationversion/library-booking-api/*",
        "arn:aws:elasticbeanstalk:ap-southeast-2:730279464171:applicationversion/library-booking-web/*"
      ]
    },
    {
      "Sid": "UpdateApplicationEnvironments",
      "Effect": "Allow",
      "Action": "elasticbeanstalk:UpdateEnvironment",
      "Resource": [
        "arn:aws:elasticbeanstalk:ap-southeast-2:730279464171:environment/library-booking-api/library-booking-api",
        "arn:aws:elasticbeanstalk:ap-southeast-2:730279464171:environment/library-booking-web/library-booking-web"
      ]
    },
    {
      "Sid": "ReadDeploymentEnvironmentState",
      "Effect": "Allow",
      "Action": [
        "elasticbeanstalk:DescribeEnvironments",
        "elasticbeanstalk:CreateStorageLocation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadElasticBeanstalkStackTemplates",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStackResource",
        "cloudformation:GetTemplate"
      ],
      "Resource": [
        "arn:aws:cloudformation:ap-southeast-2:730279464171:stack/awseb-e-iazkhqsszf-stack/*",
        "arn:aws:cloudformation:ap-southeast-2:730279464171:stack/awseb-e-pjphq3puin-stack/*"
      ]
    },
    {
      "Sid": "UploadDeploymentBundles",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::elasticbeanstalk-ap-southeast-2-730279464171"
    },
    {
      "Sid": "ManageDeploymentBundleObjects",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:GetObject",
        "s3:GetObjectAcl",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::elasticbeanstalk-ap-southeast-2-730279464171/library-booking/*"
    }
  ]
}
